{
  "productName": "Teleprompter",
  "version": "0.1.0",
  "identifier": "com.elementa.teleprompter",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:vite",
    "beforeBuildCommand": "npm run build:vite"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  },
  "app": {
    "windows": [
      {
        "label": "overlay",
        "title": "Teleprompter",
        "url": "/",
        "width": 680,
        "height": 220,
        "minWidth": 400,
        "minHeight": 120,
        "resizable": true,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "visible": true,
        "focus": true,
        "skipTaskbar": false,
        "shadow": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}
